# Formula: monoplaza de competicion; sin ABS, downforce enorme
NAME = "FORMULA"                  # nombre que aparece en el menu
DESC = "750 KG - 780 CV - SIN ABS - PARA EXPERTOS" # descripcion en el menu
CAR_COLOR = (230, 120, 20)        # color RGB de la carroceria
CAR_MASS = 750.0                  # kg, masa total del vehiculo
CAR_INERTIA_Z = 900.0             # kg*m2, inercia de giro: mas = reacciones lentas
CAR_INERTIA_PITCH = 1000.0        # kg*m2, inercia de cabeceo (frenar/acelerar)
CAR_INERTIA_ROLL = 280.0          # kg*m2, inercia de balanceo (curvas)
CHASSIS_TORSION_STIFF = 60000.0   # N*m/grado, rigidez torsional (monocasco de fibra, rigidisimo)
WHEELBASE = 3.40                  # m, distancia entre ejes
WEIGHT_DIST_FRONT = 0.45          # fraccion del peso sobre el eje delantero
CAR_CG_HEIGHT = 0.30              # m, altura del c. de gravedad: mas = mas vuelco
CAR_TRACK_WIDTH = 1.60            # m, ancho de via entre ruedas
WHEEL_SPEC = "330/50R13"          # neumatico real: deriva radio, masa e inercia coherentes
CAR_WHEEL_INERTIA = 1.1           # llanta de magnesio, masa periferica minima
UNSPRUNG_MASS = 20.0              # conjunto de competicion ligerisimo
STEER_RATIO = 8.0                 # desmultiplicacion volante->rueda: mas = suave
DRIVE_TYPE = "RWD"                # traccion: FWD delantera, RWD trasera, AWD total
DIFF_TYPE = "lsd"                 # diferencial: open, lsd (autoblocante) o locked
DIFF_LSD_COEFF = 32.0             # Nm*s, dureza del autoblocante
ENGINE_MAX_TORQUE_NM = 520.0      # Nm, par maximo del motor
ENGINE_TORQUE_PEAK_RPM = 8500.0   # rpm a las que se da el par maximo
ENGINE_IDLE_RPM = 2000.0          # rpm de ralenti
ENGINE_REDLINE_RPM = 11800.0      # rpm de zona roja
ENGINE_LIMITER_RPM = 12000.0      # rpm del corte de inyeccion
ENGINE_BRAKE_COEFF = 90.0         # Nm, freno motor al levantar el pie
GEAR_RATIOS = [2.9, 2.3, 1.9, 1.6, 1.4, 1.22] # desarrollos de cada marcha (cortos = acelera mas)
FINAL_DRIVE = 3.1                 # desmultiplicacion del grupo final
TIRE_MU = 1.55                    # agarre en asfalto seco (calle ~0.9, slick >1.2)
TIRE_PEAK_SLIP_ANGLE_DEG = 6.0    # grados de deriva del maximo agarre
TIRE_REAR_GRIP_FACTOR = 1.05      # agarre trasero relativo: >1 subvira, <1 derrapa
TIRE_RELAX_LENGTH = 0.25          # m, retardo de respuesta de la carcasa
SUSP_SPRING_FRONT = 90000.0       # N/m, muelle delantero por rueda
SUSP_SPRING_REAR = 80000.0        # N/m, muelle trasero por rueda
SUSP_DAMPER = 7500.0              # N*s/m, amortiguadores
ARB_FRONT = 40000.0               # N/m, barra estabilizadora delantera
ARB_REAR = 30000.0                # N/m, barra estabilizadora trasera
CD = 1.319                     # coef. de arrastre aerodinamico (turismo ~0.30)
FRONTAL_AREA = 1.30             # m2, area frontal del coche
CL = 5.651                     # coef. de carga aerodinamica (0 = sin apendices)
AERO_DF_FRONT_SHARE = 0.44        # fraccion de carga aero en el eje delantero
BRAKE_FORCE_MAX = 38000.0         # N, fuerza maxima de frenada total
BRAKE_BIAS_FRONT = 0.62           # fraccion de frenada al eje delantero
ABS_ENABLED = False               # True con ABS, False sin el (bloqueos reales)
ENGINE_INERTIA = 0.08             # kg*m2, volante motor: retencion al reducir
SUSP_ANTI_PITCH = 0.45            # geometria anti-hundimiento al frenar/acelerar
CAMERA_HEIGHT = 0.80              # m, ojo del conductor: a ras de asfalto
TIRE_VERT_STIFF = 350000.0        # N/m, carcasa rigida de slick
TIRE_VERT_DAMP = 1200.0           # N*s/m
SUSP_CAMBER_GAIN = 1.5            # geometria de competicion
TIRE_TEMP_OPT = 95.0              # slick: fria no agarra NADA
CAMERA_FORWARD = 0.15             # m, piloto casi centrado en el coche
