# Autobus urbano: 12 toneladas de desafio; conduzcalo con respeto
NAME = "AUTOBUS"                  # nombre que aparece en el menu
DESC = "12000 KG - 290 CV DIESEL - LENTO PERO IMPARABLE" # descripcion en el menu
CAR_COLOR = (200, 160, 30)        # color RGB de la carroceria
CAR_MASS = 12000.0                # kg, masa total del vehiculo
CAR_INERTIA_Z = 90000.0           # kg*m2, inercia de giro: mas = reacciones lentas
CAR_INERTIA_PITCH = 110000.0      # kg*m2, inercia de cabeceo (frenar/acelerar)
CAR_INERTIA_ROLL = 22000.0        # kg*m2, inercia de balanceo (curvas)
WHEELBASE = 5.90                  # m, distancia entre ejes
WEIGHT_DIST_FRONT = 0.45          # fraccion del peso sobre el eje delantero
CAR_CG_HEIGHT = 1.10              # m, altura del c. de gravedad: mas = mas vuelco
CAR_TRACK_WIDTH = 2.10            # m, ancho de via entre ruedas
CAR_WHEEL_RADIUS = 0.50           # m, radio de la rueda
CAR_WHEEL_INERTIA = 12.0          # kg*m2, inercia de cada rueda
STEER_RATIO = 22.0                # desmultiplicacion volante->rueda: mas = suave
STEER_SCRUB_RADIUS = 0.06         # m, radio de pivote: tirones al frenar/traccionar
DRIVE_TYPE = "RWD"                # traccion: FWD delantera, RWD trasera, AWD total
DIFF_TYPE = "locked"              # diferencial: open, lsd (autoblocante) o locked
ENGINE_MAX_TORQUE_NM = 1450.0     # Nm, par maximo del motor
ENGINE_TORQUE_PEAK_RPM = 1300.0   # rpm a las que se da el par maximo
ENGINE_IDLE_RPM = 550.0           # rpm de ralenti
ENGINE_REDLINE_RPM = 2300.0       # rpm de zona roja
ENGINE_LIMITER_RPM = 2500.0       # rpm del corte de inyeccion
ENGINE_BRAKE_COEFF = 300.0        # Nm, freno motor al levantar el pie
GEAR_RATIOS = [6.5, 3.8, 2.4, 1.6, 1.15, 0.82] # desarrollos de cada marcha (cortos = acelera mas)
FINAL_DRIVE = 4.9                 # desmultiplicacion del grupo final
TIRE_MU = 0.85                    # agarre en asfalto seco (calle ~0.9, slick >1.2)
TIRE_PEAK_SLIP_ANGLE_DEG = 9.0    # grados de deriva del maximo agarre
TIRE_RELAX_LENGTH = 0.9           # m, retardo de respuesta de la carcasa
SUSP_SPRING_FRONT = 260000.0      # N/m, muelle delantero por rueda
SUSP_SPRING_REAR = 300000.0       # N/m, muelle trasero por rueda
SUSP_DAMPER = 30000.0             # N*s/m, amortiguadores
ARB_FRONT = 120000.0              # N/m, barra estabilizadora delantera
ARB_REAR = 90000.0                # N/m, barra estabilizadora trasera
CD = 0.402                     # coef. de arrastre aerodinamico (turismo ~0.30)
FRONTAL_AREA = 6.50             # m2, area frontal del coche
CL = 0.000                     # coef. de carga aerodinamica (0 = sin apendices)
ROLLING_RESIST = 900.0            # N, resistencia a la rodadura
BRAKE_FORCE_MAX = 90000.0         # N, fuerza maxima de frenada total
BRAKE_BIAS_FRONT = 0.58           # fraccion de frenada al eje delantero
ENGINE_INERTIA = 2.2              # kg*m2, volante motor: retencion al reducir
CAMERA_HEIGHT = 2.30              # m, ojo del conductor: en lo alto de todo
UNSPRUNG_MASS = 320.0             # kg por rueda: eje rigido y gemelas
TIRE_VERT_STIFF = 2000000.0       # N/m, neumatico de camion
TIRE_VERT_DAMP = 8000.0           # N*s/m
SUSP_CAMBER_GAIN = 0.0            # eje rigido: no gana caida
CAMERA_FORWARD = 2.20             # m, conductor al frente, sobre el eje delantero
