# Todoterreno 4x4: alto, pesado, balancea mucho; bueno fuera del asfalto
NAME = "TODOTERRENO"              # nombre que aparece en el menu
DESC = "2250 KG - 250 CV - AWD - ALTO Y VALIENTE" # descripcion en el menu
CAR_COLOR = (60, 110, 60)         # color RGB de la carroceria
CAR_MASS = 2250.0                 # kg, masa total del vehiculo
CAR_INERTIA_Z = 3800.0            # kg*m2, inercia de giro: mas = reacciones lentas
CAR_INERTIA_PITCH = 4200.0        # kg*m2, inercia de cabeceo (frenar/acelerar)
CAR_INERTIA_ROLL = 1150.0         # kg*m2, inercia de balanceo (curvas)
CHASSIS_TORSION_STIFF = 7000.0    # N*m/grado, rigidez torsional (chasis de largueros, flexa mucho)
WHEELBASE = 2.85                  # m, distancia entre ejes
WEIGHT_DIST_FRONT = 0.53          # fraccion del peso sobre el eje delantero
CAR_CG_HEIGHT = 0.78              # m, altura del c. de gravedad: mas = mas vuelco
CAR_TRACK_WIDTH = 1.65            # m, ancho de via entre ruedas
WHEEL_SPEC = "245/75R16"          # neumatico real: deriva radio, masa e inercia coherentes
WHEEL_OPTIONS = ["235/85R16", "265/70R17", "285/75R16"]# monturas homologadas (menu RUEDAS)
UNSPRUNG_HUB_MASS = 40.0          # kg, mangueta+freno+suspension (sin la rueda)
STEER_RATIO = 17.0                # desmultiplicacion volante->rueda: mas = suave
CASTER_ANGLE_DEG = 3.5          # grados, angulo de avance: poco avance: volante manejable fuera de asfalto
DRIVE_TYPE = "AWD"                # traccion: FWD delantera, RWD trasera, AWD total
AWD_FRONT_SPLIT = 0.42            # fraccion del par al eje delantero (solo AWD)
DIFF_TYPE = "lsd"                 # diferencial: open, lsd (autoblocante) o locked
ENGINE_MAX_TORQUE_NM = 500.0      # Nm, par maximo del motor
ENGINE_TORQUE_PEAK_RPM = 2400.0   # rpm a las que se da el par maximo
ENGINE_REDLINE_RPM = 4600.0       # rpm de zona roja
ENGINE_LIMITER_RPM = 4800.0       # rpm del corte de inyeccion
ENGINE_BRAKE_COEFF = 65.0         # Nm, freno motor al levantar el pie
GEAR_RATIOS = [4.5, 2.6, 1.7, 1.25, 1.0, 0.83] # desarrollos de cada marcha (cortos = acelera mas)
FINAL_DRIVE = 3.7                 # desmultiplicacion del grupo final
TIRE_MU = 0.92                    # agarre en asfalto seco (calle ~0.9, slick >1.2)
TIRE_MU_GRASS = 0.88              # agarre sobre hierba
SUSP_SPRING_FRONT = 42000.0       # N/m, muelle delantero por rueda
SUSP_SPRING_REAR = 40000.0        # N/m, muelle trasero por rueda
SUSP_DAMPER = 5200.0              # N*s/m, amortiguadores
ARB_FRONT = 20000.0               # N/m, barra estabilizadora delantera
ARB_REAR = 14000.0                # N/m, barra estabilizadora trasera
CD = 0.321                     # coef. de arrastre aerodinamico (turismo ~0.30)
FRONTAL_AREA = 2.80             # m2, area frontal del coche
CL = 0.000                     # coef. de carga aerodinamica (0 = sin apendices)
BRAKE_FORCE_MAX = 24000.0         # N, fuerza maxima de frenada total
BRAKE_BIAS_FRONT = 0.68           # fraccion de frenada al eje delantero
CAMERA_HEIGHT = 1.80              # m, ojo del conductor: dominando el trafico
TIRE_VERT_STIFF = 400000.0        # N/m, globo de perfil alto
SUSP_CAMBER_GAIN = 0.15           # eje casi rigido
CAMERA_FORWARD = 0.80             # m, puesto alto y adelantado
