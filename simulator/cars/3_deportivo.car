# Deportivo: el coche de siempre del simulador (232 CV, RWD)
NAME = "DEPORTIVO"                # nombre que aparece en el menu
DESC = "1250 KG - 232 CV - RWD - EL DE SIEMPRE" # descripcion en el menu
CAR_COLOR = (178, 24, 30)         # color RGB de la carroceria
CAR_MASS = 1250.0                 # kg, masa total del vehiculo
CAR_INERTIA_Z = 1900.0            # kg*m2, inercia de giro: mas = reacciones lentas
CAR_INERTIA_PITCH = 2100.0        # kg*m2, inercia de cabeceo (frenar/acelerar)
CAR_INERTIA_ROLL = 550.0          # kg*m2, inercia de balanceo (curvas)
CHASSIS_TORSION_STIFF = 27000.0   # N*m/grado, rigidez torsional (autoportante reforzada)
WHEELBASE = 2.60                  # m, distancia entre ejes
WEIGHT_DIST_FRONT = 0.546         # fraccion del peso sobre el eje delantero
CAR_CG_HEIGHT = 0.52              # m, altura del c. de gravedad: mas = mas vuelco
CAR_TRACK_WIDTH = 1.55            # m, ancho de via entre ruedas
WHEEL_SPEC = "245/35R18"          # neumatico real: deriva radio, masa e inercia coherentes
UNSPRUNG_HUB_MASS = 14.0          # kg, mangueta+freno+suspension (sin la rueda)
STEER_RATIO = 12.0                # desmultiplicacion volante->rueda: mas = suave
DRIVE_TYPE = "RWD"                # traccion: FWD delantera, RWD trasera, AWD total
DIFF_TYPE = "lsd"                 # diferencial: open, lsd (autoblocante) o locked
ENGINE_MAX_TORQUE_NM = 320.0      # Nm, par maximo del motor
ENGINE_TORQUE_PEAK_RPM = 4200.0   # rpm a las que se da el par maximo
ENGINE_REDLINE_RPM = 6800.0       # rpm de zona roja
ENGINE_LIMITER_RPM = 7000.0       # rpm del corte de inyeccion
GEAR_RATIOS = [3.62, 2.19, 1.51, 1.17, 0.95, 0.81] # desarrollos de cada marcha (cortos = acelera mas)
FINAL_DRIVE = 3.70                # desmultiplicacion del grupo final
TIRE_MU = 1.05                    # agarre en asfalto seco (calle ~0.9, slick >1.2)
SUSP_SPRING_FRONT = 50000.0       # N/m, muelle delantero por rueda
SUSP_SPRING_REAR = 44000.0        # N/m, muelle trasero por rueda
SUSP_DAMPER = 4300.0              # N*s/m, amortiguadores
ARB_FRONT = 23000.0               # N/m, barra estabilizadora delantera
ARB_REAR = 14000.0                # N/m, barra estabilizadora trasera
CD = 0.310                     # coef. de arrastre aerodinamico (turismo ~0.30)
FRONTAL_AREA = 2.00             # m2, area frontal del coche
CL = 0.449                     # coef. de carga aerodinamica (0 = sin apendices)
BRAKE_FORCE_MAX = 15000.0         # N, fuerza maxima de frenada total
BRAKE_BIAS_FRONT = 0.72           # fraccion de frenada al eje delantero
CAMERA_HEIGHT = 1.15              # m, ojo del conductor: asiento bajo
SUSP_CAMBER_GAIN = 1.0            # paralelogramo deportivo
CAMERA_FORWARD = 0.50             # m, ojo del conductor
