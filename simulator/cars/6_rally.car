# Rally: traccion total, diferenciales cerrados, va bien por la hierba
NAME = "RALLY"                    # nombre que aparece en el menu
DESC = "1230 KG - 300 CV - AWD - REY DE LA HIERBA" # descripcion en el menu
CAR_COLOR = (30, 90, 200)         # color RGB de la carroceria
CAR_MASS = 1230.0                 # kg, masa total del vehiculo
CAR_INERTIA_Z = 1800.0            # kg*m2, inercia de giro: mas = reacciones lentas
CAR_INERTIA_PITCH = 2000.0        # kg*m2, inercia de cabeceo (frenar/acelerar)
CAR_INERTIA_ROLL = 540.0          # kg*m2, inercia de balanceo (curvas)
WHEELBASE = 2.62                  # m, distancia entre ejes
WEIGHT_DIST_FRONT = 0.56          # fraccion del peso sobre el eje delantero
CAR_CG_HEIGHT = 0.50              # m, altura del c. de gravedad: mas = mas vuelco
CAR_TRACK_WIDTH = 1.56            # m, ancho de via entre ruedas
CAR_WHEEL_RADIUS = 0.31           # m, radio de la rueda
CAR_WHEEL_INERTIA = 1.3           # kg*m2, inercia de cada rueda
STEER_RATIO = 11.0                # desmultiplicacion volante->rueda: mas = suave
DRIVE_TYPE = "AWD"                # traccion: FWD delantera, RWD trasera, AWD total
AWD_FRONT_SPLIT = 0.45            # fraccion del par al eje delantero (solo AWD)
DIFF_TYPE = "locked"              # diferencial: open, lsd (autoblocante) o locked
ENGINE_MAX_TORQUE_NM = 420.0      # Nm, par maximo del motor
ENGINE_TORQUE_PEAK_RPM = 4000.0   # rpm a las que se da el par maximo
ENGINE_REDLINE_RPM = 6600.0       # rpm de zona roja
ENGINE_LIMITER_RPM = 6800.0       # rpm del corte de inyeccion
GEAR_RATIOS = [3.5, 2.3, 1.7, 1.3, 1.05, 0.86] # desarrollos de cada marcha (cortos = acelera mas)
FINAL_DRIVE = 3.9                 # desmultiplicacion del grupo final
TIRE_MU = 1.08                    # agarre en asfalto seco (calle ~0.9, slick >1.2)
TIRE_MU_GRASS = 0.95              # agarre sobre hierba
TIRE_REAR_GRIP_FACTOR = 1.0       # agarre trasero relativo: >1 subvira, <1 derrapa
SUSP_SPRING_FRONT = 38000.0       # N/m, muelle delantero por rueda
SUSP_SPRING_REAR = 34000.0        # N/m, muelle trasero por rueda
SUSP_DAMPER = 4800.0              # N*s/m, amortiguadores
ARB_FRONT = 16000.0               # N/m, barra estabilizadora delantera
ARB_REAR = 12000.0                # N/m, barra estabilizadora trasera
AERO_DRAG = 0.40                  # N/(m/s)2, resistencia al aire
AERO_DOWNFORCE = 0.5              # N/(m/s)2, carga aerodinamica (aprieta al suelo)
BRAKE_FORCE_MAX = 17000.0         # N, fuerza maxima de frenada total
BRAKE_BIAS_FRONT = 0.66           # fraccion de frenada al eje delantero
CAMERA_HEIGHT = 1.35              # m, ojo del conductor: con casco y baquet
