# Utilitario urbano: pequeño, ligero, tracción delantera, ~75 CV
NAME = "UTILITARIO"               # nombre que aparece en el menu
DESC = "900 KG - 75 CV - FWD - FACIL Y LENTO" # descripcion en el menu
CAR_COLOR = (70, 130, 200)        # color RGB de la carroceria
CAR_MODEL_3D = "2cv"              # modelo 3D (Citroen 2CV Charleston)
CAR_MASS = 900.0                  # kg, masa total del vehiculo
CAR_INERTIA_Z = 1150.0            # kg*m2, inercia de giro: mas = reacciones lentas
CAR_INERTIA_PITCH = 1300.0        # kg*m2, inercia de cabeceo (frenar/acelerar)
CAR_INERTIA_ROLL = 380.0          # kg*m2, inercia de balanceo (curvas)
CHASSIS_TORSION_STIFF = 11000.0   # N*m/grado, rigidez torsional (carroceria autoportante basica)
WHEELBASE = 2.45                  # m, distancia entre ejes
WEIGHT_DIST_FRONT = 0.62          # fraccion del peso sobre el eje delantero
CAR_CG_HEIGHT = 0.55              # m, altura del c. de gravedad: mas = mas vuelco
CAR_TRACK_WIDTH = 1.45            # m, ancho de via entre ruedas
WHEEL_SPEC = "165/70R13"          # neumatico real: deriva radio, masa e inercia coherentes
WHEEL_OPTIONS = ["175/65R14", "185/55R15"]# monturas homologadas (menu RUEDAS)
UNSPRUNG_HUB_MASS = 17.0          # kg, mangueta+freno+suspension (sin la rueda)
STEER_RATIO = 15.0                # desmultiplicacion volante->rueda: mas = suave
CASTER_ANGLE_DEG = 2.5          # grados, angulo de avance: urbano: direccion ligera para aparcar
DRIVE_TYPE = "FWD"                # traccion: FWD delantera, RWD trasera, AWD total
DIFF_TYPE = "open"                # diferencial: open, lsd (autoblocante) o locked
ENGINE_MAX_TORQUE_NM = 118.0      # Nm, par maximo del motor
ENGINE_TORQUE_PEAK_RPM = 3800.0   # rpm a las que se da el par maximo
ENGINE_REDLINE_RPM = 6200.0       # rpm de zona roja
ENGINE_LIMITER_RPM = 6400.0       # rpm del corte de inyeccion
ENGINE_BRAKE_COEFF = 28.0         # Nm, freno motor al levantar el pie
GEAR_RATIOS = [3.9, 2.1, 1.4, 1.05, 0.85] # desarrollos de cada marcha (cortos = acelera mas)
FINAL_DRIVE = 4.1                 # desmultiplicacion del grupo final
TIRE_MU = 0.95                    # agarre en asfalto seco (calle ~0.9, slick >1.2)
SUSP_SPRING_FRONT = 18000.0       # N/m, muelle delantero por rueda
SUSP_SPRING_REAR = 14000.0        # N/m, muelle trasero por rueda
SUSP_DAMPER = 2600.0              # N*s/m, amortiguadores
TOE_FRONT_DEG = 0.1            # grados de convergencia delante
TOE_REAR_DEG = 0.15           # grados detras: urbano: comodo y estable, diferencial abierto
SUSP_DAMPER_BUMP_F = 1700      # N*s/m, compresion delantera
SUSP_DAMPER_REB_F = 3600       # N*s/m, extension delantera
SUSP_DAMPER_BUMP_R = 1500      # N*s/m, compresion trasera
SUSP_DAMPER_REB_R = 3200       # N*s/m, extension trasera
SUSP_BUMP_GAP_F = 0.085        # m libres antes del tope delante
SUSP_BUMP_GAP_R = 0.095        # m libres antes del tope detras
ARB_FRONT = 11000.0               # N/m, barra estabilizadora delantera
ARB_REAR = 4000.0                 # N/m, barra estabilizadora trasera: blanda,
                                  # deja bambolear (comodidad urbana)
CD = 0.343                     # coef. de arrastre aerodinamico (turismo ~0.30)
FRONTAL_AREA = 2.00             # m2, area frontal del coche
CL = 0.000                     # coef. de carga aerodinamica (0 = sin apendices)
BRAKE_FORCE_MAX = 9500.0          # N, fuerza maxima de frenada total
BRAKE_BIAS_FRONT = 0.74           # fraccion de frenada al eje delantero
CAMERA_HEIGHT = 1.40              # m, ojo del conductor: alto y erguido
SUSP_CAMBER_GAIN = 0.25            # rad/m: McPherson sencillo
STATIC_CAMBER_FRONT_DEG = -0.5      # grados de caida estatica delante
STATIC_CAMBER_REAR_DEG = -0.8      # grados detras: confort y desgaste parejo antes que apoyo
CAMERA_FORWARD = 0.55             # m, ojo del conductor adelantado (coche corto)
