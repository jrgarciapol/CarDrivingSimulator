<?xml version="1.0"?>
<!--
  Aplicación de reloj (watch-app), NO campo de datos.

  Un data field no puede capturar los botones (los usa la actividad
  nativa) y tiene un límite de memoria mucho menor. Como necesitamos
  botones para marcar el estrés, tiene que ser watch-app.

  El id de abajo es un GUID de ejemplo. Si vas a publicar en la tienda,
  genera el tuyo con el asistente "New Project" del SDK / la extensión
  de VS Code. Para uso propio (sideload) sirve tal cual.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="7c1f4a92b6d84e3fa05c2d9e6b71f430"
        type="watch-app"
        name="@Strings.AppName"
        entry="StressLogApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.2.0">

        <iq:products>
            <!-- Epix Pro (Gen 2), los tres tamaños -->
            <iq:product id="epix2pro42mm"/>
            <iq:product id="epix2pro47mm"/>
            <iq:product id="epix2pro51mm"/>
            <!-- Útiles para probar en el simulador del SDK -->
            <iq:product id="epix2"/>
            <iq:product id="fenix7"/>
            <iq:product id="fr965"/>
        </iq:products>

        <iq:permissions>
            <!-- ActivityRecording + FitContributor -->
            <iq:uses-permission id="Fit"/>
            <!-- Sensor.registerSensorDataListener (intervalos R-R + acelerómetro) -->
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>spa</iq:language>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
