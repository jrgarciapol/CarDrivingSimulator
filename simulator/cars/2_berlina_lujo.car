# Berlina de lujo: grande, pesada, suave y potente; propulsion
NAME = "BERLINA DE LUJO"          # nombre que aparece en el menu
DESC = "1950 KG - 340 CV - RWD - COMODA Y RAPIDA" # descripcion en el menu
CAR_COLOR = (40, 40, 48)          # color RGB de la carroceria
CAR_MASS = 1950.0                 # kg, masa total del vehiculo
CAR_INERTIA_Z = 3200.0            # kg*m2, inercia de giro: mas = reacciones lentas
CAR_INERTIA_PITCH = 3600.0        # kg*m2, inercia de cabeceo (frenar/acelerar)
CAR_INERTIA_ROLL = 850.0          # kg*m2, inercia de balanceo (curvas)
CHASSIS_TORSION_STIFF = 24000.0   # N*m/grado, rigidez torsional (carroceria muy rigida, aislamiento)
WHEELBASE = 3.05                  # m, distancia entre ejes
WEIGHT_DIST_FRONT = 0.52          # fraccion del peso sobre el eje delantero
CAR_CG_HEIGHT = 0.54              # m, altura del c. de gravedad: mas = mas vuelco
CAR_TRACK_WIDTH = 1.62            # m, ancho de via entre ruedas
WHEEL_SPEC_FRONT = "245/40R19"    # neumatico delantero (real)
WHEEL_SPEC_REAR = "275/35R19"     # trasero MAS ANCHO: es el eje motriz
WHEEL_OPTIONS = ["225/50R17", "245/45R18"]# monturas homologadas (menu RUEDAS)
UNSPRUNG_HUB_MASS = 21.0          # kg, mangueta+freno+suspension (sin la rueda)
STEER_RATIO = 15.0                # desmultiplicacion volante->rueda: mas = suave
DRIVE_TYPE = "RWD"                # traccion: FWD delantera, RWD trasera, AWD total
DIFF_TYPE = "open"                # diferencial: open, lsd (autoblocante) o locked
ENGINE_MAX_TORQUE_NM = 480.0      # Nm, par maximo del motor
ENGINE_TORQUE_PEAK_RPM = 3600.0   # rpm a las que se da el par maximo
ENGINE_REDLINE_RPM = 6200.0       # rpm de zona roja
ENGINE_LIMITER_RPM = 6400.0       # rpm del corte de inyeccion
ENGINE_BRAKE_COEFF = 55.0         # Nm, freno motor al levantar el pie
GEAR_RATIOS = [4.1, 2.5, 1.7, 1.3, 1.0, 0.82] # desarrollos de cada marcha (cortos = acelera mas)
FINAL_DRIVE = 3.2                 # desmultiplicacion del grupo final
TIRE_MU = 1.0                     # agarre en asfalto seco (calle ~0.9, slick >1.2)
SUSP_SPRING_FRONT = 34000.0       # N/m, muelle delantero por rueda
SUSP_SPRING_REAR = 30000.0        # N/m, muelle trasero por rueda
SUSP_DAMPER = 4600.0              # N*s/m, amortiguadores
ARB_FRONT = 26000.0               # N/m, barra estabilizadora delantera
ARB_REAR = 12000.0                # N/m, barra estabilizadora trasera
CD = 0.284                     # coef. de arrastre aerodinamico (turismo ~0.30)
FRONTAL_AREA = 2.30             # m2, area frontal del coche
CL = 0.142                     # coef. de carga aerodinamica (0 = sin apendices)
BRAKE_FORCE_MAX = 22000.0         # N, fuerza maxima de frenada total
BRAKE_BIAS_FRONT = 0.70           # fraccion de frenada al eje delantero
CAMERA_HEIGHT = 1.30              # m, ojo del conductor: berlina comoda
SUSP_CAMBER_GAIN = 0.6            # confort antes que apoyo
CAMERA_FORWARD = 0.45             # m, ojo del conductor a media cabina
