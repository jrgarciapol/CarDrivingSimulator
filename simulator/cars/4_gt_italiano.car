# GT italiano: superdeportivo de calle, mucho motor y mucho agarre
NAME = "GT ITALIANO"              # nombre que aparece en el menu
DESC = "1420 KG - 620 CV - RWD - PURA SANGRE" # descripcion en el menu
CAR_COLOR = (210, 30, 30)         # color RGB de la carroceria
CAR_MODEL_3D = "lambo"            # modelo 3D (Lamborghini Centenario)
CAR_MASS = 1420.0                 # kg, masa total del vehiculo
CAR_INERTIA_Z = 2100.0            # kg*m2, inercia de giro: mas = reacciones lentas
CAR_INERTIA_PITCH = 2300.0        # kg*m2, inercia de cabeceo (frenar/acelerar)
CAR_INERTIA_ROLL = 560.0          # kg*m2, inercia de balanceo (curvas)
CHASSIS_TORSION_STIFF = 35000.0   # N*m/grado, rigidez torsional (chasis de competicion GT)
WHEELBASE = 2.65                  # m, distancia entre ejes
WEIGHT_DIST_FRONT = 0.46          # fraccion del peso sobre el eje delantero
CAR_CG_HEIGHT = 0.44              # m, altura del c. de gravedad: mas = mas vuelco
CAR_TRACK_WIDTH = 1.67            # m, ancho de via entre ruedas
WHEEL_SPEC_FRONT = "245/35R19"    # neumatico delantero (real)
WHEEL_SPEC_REAR = "305/30R20"     # trasero MAS ANCHO: es el eje motriz
WHEEL_OPTIONS = ["285/35R18", "305/30R20"]# monturas homologadas (menu RUEDAS)
UNSPRUNG_HUB_MASS = 8.0           # kg, mangueta+freno+suspension (sin la rueda)
STEER_RATIO = 11.0                # desmultiplicacion volante->rueda: mas = suave
CASTER_ANGLE_DEG = 6.5          # grados, angulo de avance: GT: mucho avance, volante pesado y preciso
DRIVE_TYPE = "RWD"                # traccion: FWD delantera, RWD trasera, AWD total
DIFF_TYPE = "lsd"                 # diferencial: open, lsd (autoblocante) o locked
DIFF_LSD_COEFF = 28.0             # Nm*s, dureza del autoblocante
ENGINE_MAX_TORQUE_NM = 690.0      # Nm, par maximo del motor
ENGINE_TORQUE_PEAK_RPM = 6000.0   # rpm a las que se da el par maximo
ENGINE_REDLINE_RPM = 8800.0       # rpm de zona roja
ENGINE_LIMITER_RPM = 9000.0       # rpm del corte de inyeccion
ENGINE_BRAKE_COEFF = 70.0         # Nm, freno motor al levantar el pie
GEAR_RATIOS = [3.08, 2.19, 1.63, 1.29, 1.03, 0.84] # desarrollos de cada marcha (cortos = acelera mas)
FINAL_DRIVE = 3.5                 # desmultiplicacion del grupo final
TIRE_MU = 1.25                    # agarre en asfalto seco (calle ~0.9, slick >1.2)
TIRE_REAR_GRIP_FACTOR = 1.06      # agarre trasero relativo: >1 subvira, <1 derrapa
SUSP_SPRING_FRONT = 60000.0       # N/m, muelle delantero por rueda
SUSP_SPRING_REAR = 55000.0        # N/m, muelle trasero por rueda
SUSP_DAMPER = 5600.0              # N*s/m, amortiguadores
TOE_FRONT_DEG = -0.1           # grados de convergencia delante
TOE_REAR_DEG = 0.2            # grados detras: GT: divergencia delante para afilar la entrada
SUSP_DAMPER_BUMP_F = 3400      # N*s/m, compresion delantera
SUSP_DAMPER_REB_F = 7000       # N*s/m, extension delantera
SUSP_DAMPER_BUMP_R = 3000      # N*s/m, compresion trasera
SUSP_DAMPER_REB_R = 6200       # N*s/m, extension trasera
SUSP_BUMP_GAP_F = 0.055        # m libres antes del tope delante
SUSP_BUMP_GAP_R = 0.06         # m libres antes del tope detras
DIFF_PRELOAD = 90             # N*m de bloqueo permanente
DIFF_RAMP_POWER = 0.6          # bloqueo acelerando
DIFF_RAMP_COAST = 0.35         # bloqueo reteniendo
ARB_FRONT = 30000.0               # N/m, barra estabilizadora delantera
ARB_REAR = 20000.0                # N/m, barra estabilizadora trasera
CD = 0.309                     # coef. de arrastre aerodinamico (turismo ~0.30)
FRONTAL_AREA = 1.90             # m2, area frontal del coche
CL = 1.117                     # coef. de carga aerodinamica (0 = sin apendices)
AERO_DF_FRONT_SHARE = 0.44        # fraccion de carga aero en el eje delantero
BRAKE_FORCE_MAX = 26000.0         # N, fuerza maxima de frenada total
BRAKE_BIAS_FRONT = 0.68           # fraccion de frenada al eje delantero
CAMERA_HEIGHT = 1.05              # m, ojo del conductor: casi tumbado
SUSP_CAMBER_GAIN = 0.55            # rad/m: geometria de circuito
STATIC_CAMBER_FRONT_DEG = -3.0      # grados de caida estatica delante
STATIC_CAMBER_REAR_DEG = -2.2      # grados detras: reglaje de circuito: mucho apoyo en curva
TIRE_TEMP_OPT = 95.0              # goma semislick: pide temperatura
CAMERA_FORWARD = 0.40             # m, motor central: piloto algo adelantado
